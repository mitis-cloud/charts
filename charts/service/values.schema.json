{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mitis service",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$", "maxLength": 40, "description": "Stable service identity; defaults to the release name. Keep it fixed across rendering phases."},
    "workload": {"enum": ["deployment", "resources"], "description": "Run a continuous service or only its explicitly declared resources/jobs. Stateful workloads are roadmap-only."},
    "image": {"$ref": "#/definitions/image"},
    "command": {"$ref": "#/definitions/strings"},
    "args": {"$ref": "#/definitions/strings"},
    "workingDirectory": {"$ref": "#/definitions/path"},
    "capacity": {"$ref": "#/definitions/capacity"},
    "availability": {"type": "object", "additionalProperties": false, "required": ["zones"], "properties": {"zones": {"type": "integer", "minimum": 2, "description": "Strict eligible-zone spread; no automatic relaxation during zone loss."}}},
    "ports": {"$ref": "#/definitions/ports"},
    "http": {"$ref": "#/definitions/http"},
    "response": {"type": "object", "additionalProperties": false, "required": ["status", "body"], "properties": {
      "status": {"type": "integer", "minimum": 200, "maximum": 599, "not": {"minimum": 300, "maximum": 399}},
      "contentType": {"enum": ["text/plain", "text/css", "text/html", "application/javascript", "application/json"]},
      "body": {"type": "string", "maxLength": 1024}
    }, "description": "Fixed HTTP response without a running container. Requires resource-only workload and ALB ingress routing; body is limited to 1024 bytes."},
    "health": {"$ref": "#/definitions/health"},
    "environment": {"$ref": "#/definitions/environment"},
    "files": {"$ref": "#/definitions/files"},
    "tokens": {"$ref": "#/definitions/tokens"},
    "mounts": {"$ref": "#/definitions/mounts"},
    "identity": {"$ref": "#/definitions/identity"},
    "security": {"enum": ["image-defaults", "restricted"], "description": "Restricted containers run non-root with a read-only root filesystem, no privilege escalation, all capabilities dropped, and the runtime-default seccomp profile."},
    "architecture": {"enum": ["amd64", "arm64"], "description": "Required node architecture when an image supports only one platform."},
    "discovery": {"enum": ["dns", "environment"], "description": "DNS discovery by default; environment also injects Kubernetes service-link variables."},
    "account": {"$ref": "#/definitions/name", "description": "Existing infrastructure-owned service account, including any cloud identity binding. Mutually exclusive with chart-owned permissions."},
    "apiToken": {"type": "boolean", "description": "Mount the service account API token; defaults to true to preserve Kubernetes defaults."},
    "shutdown": {"type": "integer", "minimum": 1, "description": "Graceful shutdown budget in seconds."},
    "fileGroup": {"type": "integer", "minimum": 0, "description": "Group ID used for writable pod volumes."},
    "domain": {"type": "string"},
    "sharedStorage": {"$ref": "#/definitions/name", "description": "Existing shared-filesystem storage class, supplied once by environment defaults. Required when provisioning shared volumes."},
    "secretPrefix": {"type": "string", "description": "Prefix prepended to remote-secret names. Secret values never belong here."},
    "secretStore": {"$ref": "#/definitions/name", "description": "Existing cluster secret-store identity supplied by environment composition."},
    "secretRefresh": {"$ref": "#/definitions/duration", "description": "Refresh interval for generated input Secrets; defaults to 1h."},
    "inputSecret": {"$ref": "#/definitions/name", "description": "Stable target for this process's generated environment inputs; defaults to its identity plus -secrets."},
    "facts": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}, "description": "Authoritative application environment facts referenced by name; not a manifest or template interface."},
    "placement": {"$ref": "#/definitions/name", "description": "Existing environment-owned workload pool, such as spot or stable; any adds no placement constraint."},
    "updates": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["rolling", "replace", "canary"]},
        "reload": {"type": "boolean", "description": "Replace instances when declared configuration or synchronized Secrets change."},
        "reloadSecrets": {"type": "boolean", "description": "With reload enabled, also react to synchronized Secret changes. Disable explicitly to preserve configuration-only replacement."},
        "restart": {"type": "string", "description": "Explicit rollout token supplied by the deployment operation; no render-time clock."},
        "smoke": {"allOf": [{"$ref": "#/definitions/job"}, {"required": ["command", "timeout", "capacity"], "not": {"anyOf": [{"required": ["run"]}, {"required": ["schedule"]}, {"required": ["order"]}, {"required": ["suspend"]}, {"required": ["name"]}]}}]}
      }
    },
    "disruption": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "handover": {"type": "boolean"},
        "maxWait": {"$ref": "#/definitions/duration"},
        "name": {"$ref": "#/definitions/name"}
      }
    },
    "storage": {
      "type": "object", "propertyNames": {"$ref": "#/definitions/name"},
      "additionalProperties": {
         "oneOf": [
           {"type": "null"},
           {"type": "object", "additionalProperties": false, "required": ["access"], "properties": {
            "access": {"const": "shared"}, "name": {"$ref": "#/definitions/name"},
            "size": {"$ref": "#/definitions/quantity", "description": "PVC request metadata; not an EFS quota."},
            "retain": {"type": "boolean", "description": "Retain the claim on chart removal; defaults to true."}
          }},
          {"type": "object", "additionalProperties": false, "required": ["existing"], "properties": {"existing": {"$ref": "#/definitions/name"}}},
          {"type": "object", "additionalProperties": false, "required": ["temporary"], "properties": {
            "temporary": {"const": true}, "medium": {"enum": ["disk", "memory"]},
            "sizeLimit": {"$ref": "#/definitions/quantity", "description": "Workspace limit, not reserved capacity. Memory-backed contents count against memory."}
          }}
        ]
      }
    },
    "init": {"$ref": "#/definitions/containers"},
    "sidecars": {"$ref": "#/definitions/containers"},
    "jobs": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/job"}]}},
    "outputs": {
      "type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["ssm"],
        "properties": {
          "ssm": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["key"], "properties": {"key": {"type": "string", "minLength": 1}, "absolute": {"type": "boolean"}}}]},
          "sensitive": {"type": "boolean", "description": "Store encrypted; defaults to true."}
        }
      },
      "description": "Values the service writes to its <name>-outputs Secret, published to the secret store. Processes read them back with {output: key}."
    },
    "permissions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["group", "resources", "actions"],
        "properties": {
          "group": {"type": "string"}, "resources": {"$ref": "#/definitions/strings"},
          "actions": {"type": "array", "items": {"enum": ["get", "list", "watch", "create", "update", "patch", "delete"]}},
          "names": {"$ref": "#/definitions/strings"}
        }
      }, "description": "Namespace-scoped API permissions for an actual controller/helper requirement. Never grants cluster permissions."
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["helm", "argo"]},
        "part": {"enum": ["all", "inputs", "runtime", "application", "scheduled", "task"]},
        "routing": {"enum": ["ingress", "gateway"]},
        "order": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Native Argo ordering between coordinated services; each slot contains inputs, before-jobs, runtime, and after-jobs."},
        "task": {"type": "string"},
        "capacity": {"enum": ["git", "external"], "description": "Who owns replica counts in Argo mode: git pins the Understudy baseline; external lets a scaler own them."}
      }, "description": "Finite orchestration selectors; every part must have a stable owner. Do not switch parts on an existing Helm release."
    },
    "global": {"type": "object", "additionalProperties": false, "description": "Helm injects an empty global object into dependencies. No public fields are accepted here."}
  },
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "path": {"type": "string", "pattern": "^/"},
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
    "quantity": {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "image": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^ @]+$"},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }, "description": "Helpers inherit the entire main image unless this object is present. Digest takes precedence over tag."
    },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "instances": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "cpu": {"$ref": "#/definitions/cpu"},
        "memory": {"$ref": "#/definitions/quantity"},
        "cpuLimit": {"$ref": "#/definitions/cpu"},
        "memoryLimit": {"$ref": "#/definitions/quantity"}
      }, "description": "Baseline instances, scheduling reservations, and ceilings. CPU has no default ceiling."
    },
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "ports": {
      "type": "object", "propertyNames": {"type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 15},
      "additionalProperties": {"oneOf": [
        {"$ref": "#/definitions/port"},
        {"type": "object", "additionalProperties": false, "required": ["target", "listen"], "properties": {"target": {"$ref": "#/definitions/port"}, "listen": {"$ref": "#/definitions/port"}}}
      ]}, "description": "Named listening ports. Simple http exposes port 80 internally; other simple ports expose their own number."
    },
    "http": {
      "type": "object", "additionalProperties": false, "required": ["exposure"],
      "properties": {
        "exposure": {"enum": ["public", "private"]}, "hostname": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": -1000, "maximum": 1000, "description": "Explicit precedence in a shared ALB; lower numbers match first. Ingress mode only."},
        "redirectFromHttp": {"type": "boolean", "description": "Also accept plain HTTP solely to redirect it to HTTPS."},
        "subdomain": {"type": "string"}, "aliases": {"$ref": "#/definitions/strings"},
        "port": {"type": "string"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/path"}},
        "healthcheck": {"type": "object", "additionalProperties": false, "properties": {
          "path": {"$ref": "#/definitions/path"}, "successCodes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 100, "maximum": 599}}
        }}
      }
    },
    "health": {"type": "object", "additionalProperties": false, "properties": {
      "startup": {"$ref": "#/definitions/probe"}, "readiness": {"$ref": "#/definitions/probe"}, "liveness": {"$ref": "#/definitions/probe"}
    }},
    "probe": {
      "type": "object", "additionalProperties": false,
      "oneOf": [{"required": ["http"], "not": {"required": ["tcp"]}}, {"required": ["tcp"], "not": {"required": ["http"]}}],
      "properties": {
        "http": {"$ref": "#/definitions/path"}, "tcp": {"type": ["string", "integer"]}, "port": {"type": ["string", "integer"]},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "delay": {"type": "integer", "minimum": 0}, "interval": {"type": "integer", "minimum": 1},
        "timeout": {"type": "integer", "minimum": 1}, "failures": {"type": "integer", "minimum": 1}
      }
    },
    "remote": {"oneOf": [
      {"type": "string", "minLength": 1},
      {"type": "object", "additionalProperties": false, "required": ["key"], "properties": {"key": {"type": "string", "minLength": 1}, "property": {"type": "string"}, "absolute": {"type": "boolean"}}}
    ]},
    "secret": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"$ref": "#/definitions/name"}, "key": {"type": "string", "minLength": 1}}},
    "environment": {
      "type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {"oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"$ref": "#/definitions/environmentInput"},
        {"type": "object", "additionalProperties": false, "required": ["secret"], "properties": {"secret": {"$ref": "#/definitions/secret"}}},
        {"type": "object", "additionalProperties": false, "required": ["instance"], "properties": {"instance": {"enum": ["name", "namespace", "ip"]}}},
        {"type": "object", "additionalProperties": false, "required": ["output"], "properties": {"output": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}}, "description": "A value this service published through outputs; empty until first written."},
        {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {
          "type": "object", "additionalProperties": false, "properties": {"hostname": {"type": "string"}, "subdomain": {"type": "string"}, "path": {"$ref": "#/definitions/path"}, "scheme": {"enum": ["http", "https"]}}
        }}},
        {"type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": {"endpoint": {
          "type": "object", "additionalProperties": false, "required": ["service"], "properties": {"service": {"$ref": "#/definitions/name"}, "port": {"$ref": "#/definitions/port"}, "path": {"$ref": "#/definitions/path"}, "scheme": {"enum": ["http", "https"]}}
        }}}
      ]}
    },
    "environmentInput": {
      "type": "object", "additionalProperties": false,
      "oneOf": [{"required": ["ssm"]}, {"required": ["format"]}, {"required": ["fact"]}, {"required": ["value"]}],
      "properties": {
        "value": {"type": ["string", "number", "boolean"]},
        "name": {"$ref": "#/definitions/name", "description": "Existing target Secret identity for this remote-backed input; defaults to the process inputSecret."},
        "ssm": {"$ref": "#/definitions/remote"}, "format": {"type": "string"},
        "fact": {"type": "string", "minLength": 1},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Existing target Secret key when different from the variable name; valid only for a remote-backed input."}
      }
    },
    "ssm": {"type": "object", "additionalProperties": false, "required": ["ssm"], "properties": {"ssm": {"$ref": "#/definitions/remote"}}},
    "format": {"type": "object", "additionalProperties": false, "required": ["format"], "properties": {"format": {"type": "string"}}, "description": "Literal text with explicit {ssm:key} or {fact:name} substitutions; |urlquery is the only supported encoding operation."},
    "document": {"oneOf": [
      {"type": ["string", "number", "boolean", "null"]},
      {"$ref": "#/definitions/ssm"},
      {"$ref": "#/definitions/format"},
      {"type": "object", "additionalProperties": false, "required": ["fact"], "properties": {"fact": {"type": "string", "minLength": 1}}},
      {"type": "array", "items": {"$ref": "#/definitions/document"}},
      {"type": "object", "additionalProperties": {"$ref": "#/definitions/document"}, "not": {"anyOf": [{"required": ["ssm"]}, {"required": ["format"]}, {"required": ["fact"]}]}}
    ]},
    "files": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "oneOf": [{"required": ["content"]}, {"required": ["secret"]}, {"required": ["ssm"]}, {"required": ["format"]}, {"required": ["yaml"]}, {"required": ["json"]}, {"required": ["from"]}],
      "properties": {
        "path": {"$ref": "#/definitions/path"}, "content": {"type": "string"}, "secret": {"$ref": "#/definitions/secret"},
        "ssm": {"$ref": "#/definitions/remote"}, "format": {"type": "string"},
        "yaml": {"$ref": "#/definitions/document"}, "json": {"$ref": "#/definitions/document"},
        "from": {"$ref": "#/definitions/name", "description": "Consume a uniquely named file declared by this service or one of its helpers."},
        "name": {"$ref": "#/definitions/name"}, "key": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511}
      },
      "allOf": [{"if": {"required": ["from"]}, "then": {"not": {"anyOf": [{"required": ["name"]}, {"required": ["key"]}]}}}]
    }]}},
    "mounts": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {"oneOf": [
      {"type": "null"},
      {"$ref": "#/definitions/path"},
      {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {
        "path": {"$ref": "#/definitions/path"}, "readOnly": {"type": "boolean"},
        "subdirectory": {"type": "string", "minLength": 1, "pattern": "^[^/].*"}
      }}
    ]}},
    "tokens": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["audience", "path"],
      "properties": {
        "audience": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/[^/].*", "description": "Dedicated read-only directory; the rotating token is available at <path>/token."},
        "lifetime": {"type": "integer", "minimum": 600, "maximum": 86400, "description": "Requested validity in seconds, default 3600; the API server may adjust it."}
      }
    }},
    "identity": {"type": "object", "additionalProperties": false, "properties": {"user": {"type": "integer", "minimum": 0}, "group": {"type": "integer", "minimum": 0}}},
    "containers": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {"$ref": "#/definitions/container"}},
    "container": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/definitions/image"}, "command": {"$ref": "#/definitions/strings"}, "args": {"$ref": "#/definitions/strings"},
        "workingDirectory": {"$ref": "#/definitions/path"}, "capacity": {"$ref": "#/definitions/containerCapacity"}, "ports": {"$ref": "#/definitions/ports"},
        "environment": {"$ref": "#/definitions/environment"}, "health": {"$ref": "#/definitions/health"},
        "inputSecret": {"$ref": "#/definitions/name"},
        "files": {"$ref": "#/definitions/files"}, "tokens": {"$ref": "#/definitions/tokens"}, "mounts": {"$ref": "#/definitions/mounts"}, "identity": {"$ref": "#/definitions/identity"},
        "security": {"enum": ["image-defaults", "restricted"]}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/definitions/name"}, "image": {"$ref": "#/definitions/image"},
        "command": {"$ref": "#/definitions/strings"}, "args": {"$ref": "#/definitions/strings"}, "workingDirectory": {"$ref": "#/definitions/path"},
        "capacity": {"$ref": "#/definitions/containerCapacity"}, "environment": {"$ref": "#/definitions/environment"},
        "inputSecret": {"$ref": "#/definitions/name"},
        "files": {"$ref": "#/definitions/files"}, "tokens": {"$ref": "#/definitions/tokens"}, "mounts": {"$ref": "#/definitions/mounts"}, "identity": {"$ref": "#/definitions/identity"},
        "init": {"$ref": "#/definitions/containers"}, "run": {"enum": ["before", "after-ready", "manual"]},
        "schedule": {"type": "string", "minLength": 9}, "order": {"type": "integer", "minimum": 0, "maximum": 9},
        "timeout": {"oneOf": [{"$ref": "#/definitions/duration"}, {"const": "none"}], "description": "Execution deadline; none explicitly preserves jobs without a controller deadline."}, "retries": {"type": "integer", "minimum": 0}, "suspend": {"type": "boolean"},
        "timeZone": {"type": "string", "minLength": 1, "description": "IANA time zone for a scheduled job."},
        "discovery": {"enum": ["dns", "environment"]},
        "security": {"enum": ["image-defaults", "restricted"]},
        "apiToken": {"type": "boolean"},
        "account": {"$ref": "#/definitions/name"},
        "fileGroup": {"type": "integer", "minimum": 0},
         "cleanup": {"oneOf": [{"enum": ["on-success", "on-completion", "next-run"]}, {"$ref": "#/definitions/duration"}], "description": "Release-job result retention or elapsed retention after completion; defaults to on-success."},
         "resultLifetime": {"$ref": "#/definitions/duration", "description": "Optional TTL for results retained by a release job's immediate cleanup policy."},
        "history": {"type": "object", "additionalProperties": false, "properties": {"successful": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}},
        "startDeadline": {"type": "integer", "minimum": 1, "description": "Scheduled job's maximum late-start budget in seconds."}
      },
      "not": {"required": ["run", "schedule"]}
    },
    "containerCapacity": {"allOf": [{"$ref": "#/definitions/capacity"}, {"not": {"required": ["instances"]}}]},
    "cpu": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "pattern": "^[0-9]+([.][0-9]+)?m?$"}]}
  }
}
