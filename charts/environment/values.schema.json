{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63,
      "description": "Application namespace the environment owns; also the environment's name."
    },
    "exposures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "private"
        ]
      },
      "description": "Exposure profiles services may select with http.exposure."
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Restrict outbound traffic to the namespace, cluster DNS, the internet and privatePorts on platform private networks."
        },
        "privatePorts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "contentType": {
          "enum": [
            "text/plain",
            "text/css",
            "text/html",
            "application/javascript",
            "application/json"
          ]
        },
        "body": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "hostnames": {
            "minItems": 1
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "prefix"
      ],
      "description": "Secret store and remote key prefix for the environment's values, and the values generated for it when absent.",
      "properties": {
        "store": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string"
        },
        "generated": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "password",
                  "string",
                  "username",
                  "manual",
                  "value"
                ]
              },
              "length": {
                "type": "integer",
                "minimum": 8,
                "maximum": 128
              },
              "value": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "string"
                    }
                  }
                },
                "then": {
                  "required": [
                    "length"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "value"
                    }
                  }
                },
                "then": {
                  "required": [
                    "value"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "databases": {
      "type": "object",
      "description": "PostgreSQL databases named <namespace>-<key> unless name is set.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "extensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "schemas": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operator",
                "reader"
              ],
              "properties": {
                "operator": {
                  "enum": [
                    "full",
                    "read",
                    "read-execute",
                    "none"
                  ]
                },
                "reader": {
                  "enum": [
                    "full",
                    "read",
                    "read-execute",
                    "none"
                  ]
                }
              }
            }
          },
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "admin",
                "operator",
                "reader"
              ]
            }
          }
        }
      }
    },
    "webapps": {
      "type": "object",
      "description": "Web applications by name, sharing the environment's maintenance switch.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostname"
        ],
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "cachedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "application",
              "files",
              "origin"
            ]
          },
          "origin": {
            "type": "object",
            "description": "The existing HTTPS origin served in origin mode, which only answers requests carrying the secret header.",
            "additionalProperties": false,
            "required": [
              "hostname",
              "secretRef"
            ],
            "properties": {
              "hostname": {
                "type": "string",
                "minLength": 1
              },
              "secretRef": {
                "type": "object",
                "description": "Secret in the environment namespace holding the secret header value.",
                "additionalProperties": false,
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "mode": {
              "const": "origin"
            }
          },
          "required": [
            "mode"
          ]
        },
        "then": {
          "required": [
            "origin"
          ]
        },
        "else": {
          "not": {
            "required": [
              "origin"
            ]
          }
        }
      }
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable bucket name used by application protocols.",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
          },
          "versioning": {
            "type": "boolean",
            "default": true
          },
          "expireAfterDays": {
            "type": "integer",
            "minimum": 1,
            "description": "Delete current objects after this many days; omitted means no expiry."
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "serviceAccounts",
          "storage"
        ],
        "properties": {
          "serviceAccounts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "storage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "access"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ObjectStorage in this namespace, or a platform storage catalog entry when external is true."
                },
                "external": {
                  "type": "boolean",
                  "default": false
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "read",
                    "readWrite"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "allowNodeAssumption": {
            "type": "boolean",
            "default": false,
            "description": "Also permit the platform's worker identities to assume this identity for engines using instance credentials."
          },
          "listStorage": {
            "type": "boolean",
            "default": false,
            "description": "Allow storage discovery across the account for engines that enumerate buckets."
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "databases": {
            "minProperties": 1
          }
        },
        "required": [
          "databases"
        ]
      },
      "then": {
        "required": [
          "secrets"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "webapps": {
            "minProperties": 1
          }
        },
        "required": [
          "webapps"
        ]
      },
      "then": {
        "required": [
          "secrets"
        ]
      }
    }
  ]
}
